@@ -100,6 +101,58 @@ static DEFINE_MUTEX(nf_conntrack_mutex);
 #define MAX_CHAINLEN	(80u - MIN_CHAINLEN)
 
 static struct conntrack_gc_work conntrack_gc_work;
+static DEFINE_MUTEX(nf_hos_user_ops_lock);
+static const struct nf_hos_user_ops __rcu *g_nf_hos_user_ops = NULL;
+
+int nf_hos_user_register_ops(const struct nf_hos_user_ops *ops)
+{
+	if (!ops)
+		return -EINVAL;
+	printk("nf_hos_user_register_ops: ops=%p\n", ops);
+	mutex_lock(&nf_hos_user_ops_lock);
+	if (rcu_access_pointer(g_nf_hos_user_ops)) {
+		mutex_unlock(&nf_hos_user_ops_lock);
+		return -EBUSY;
+	}
+	rcu_assign_pointer(g_nf_hos_user_ops, ops);
+	mutex_unlock(&nf_hos_user_ops_lock);
+
+	return 0;
+}
+EXPORT_SYMBOL(nf_hos_user_register_ops);
+
+void nf_hos_user_unregister_ops(const struct nf_hos_user_ops *ops)
+{
+	mutex_lock(&nf_hos_user_ops_lock);
+	if (rcu_access_pointer(g_nf_hos_user_ops) == ops)
+		RCU_INIT_POINTER(g_nf_hos_user_ops, NULL);
+	mutex_unlock(&nf_hos_user_ops_lock);
+	synchronize_rcu();
+}
+EXPORT_SYMBOL(nf_hos_user_unregister_ops);
+
+void nf_hos_user_conn_add(struct nf_conn *ct)
+{
+	const struct nf_hos_user_ops *ops;
+
+	rcu_read_lock();
+	ops = rcu_dereference(g_nf_hos_user_ops);
+	if (ops && ops->conn_add){
+		ops->conn_add(ct);
+	}
+	rcu_read_unlock();
+}
+
+void nf_hos_user_conn_del(struct nf_conn *ct)
+{
+	const struct nf_hos_user_ops *ops;
+
+	rcu_read_lock();
+	ops = rcu_dereference(g_nf_hos_user_ops);
+	if (ops && ops->conn_del)
+		ops->conn_del(ct);
+	rcu_read_unlock();
+}
 
